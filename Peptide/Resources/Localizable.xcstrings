    "Tap to remove. Use \"Add peptide\" to swap one in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للإزالة. استخدم \"إضافة ببتيد\" لاستبدال واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie zum Entfernen. Verwenden Sie \"Peptid hinzufügen\", um es zu tauschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para eliminar. Usa \"Agregar péptido\" para intercambiar uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour supprimer. Utilisez « Ajouter peptide » pour en échanger un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして削除します。ペプチドを追加を使用して交換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
