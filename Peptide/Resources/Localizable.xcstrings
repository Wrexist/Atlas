    "Tap a peptide to give it its own days and frequency.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un péptido para darle sus propios días y frecuencia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击肽以给予其自己的天数和频率。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペプチドをタップして、独自の日数と頻度を設定します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf ein Peptid, um ihm eigene Tage und Häufigkeit zu geben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un peptide pour lui donner ses propres jours et sa fréquence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um peptídeo para dar a ele seus próprios dias e frequência."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펩타이드를 탭하여 자신의 요일과 빈도를 설정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь пептида, чтобы установить его собственные дни и частоту."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على ببتيد لإعطائه أيامه وتكراره الخاص."
          }
        }
      }
    },
    "Tap to edit schedule": {
      "localizations": {
