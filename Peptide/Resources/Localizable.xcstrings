          "stringUnit": {
            "state": "translated",
            "value": "Atlas Pro År"
          }
        }
      }
    },
    "Atlas Pro exports your full history as CSV, JSON, or PDF, so you are never locked in.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlas Pro exporterar hela din historik som CSV, JSON eller PDF, så att du aldrig är inlåst."
