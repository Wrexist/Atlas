    "Sign in with your Apple ID to back up and sync your protocols. All features work without signing in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الدخول باستخدام Apple ID لعمل نسخة احتياطية ومزامنة بروتوكولاتك. جميع الميزات تعمل بدون تسجيل دخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich mit Ihrer Apple ID an, um Ihre Protokolle zu sichern und zu synchronisieren. Alle Funktionen funktionieren ohne Anmeldung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu Apple ID para hacer copia de seguridad y sincronizar tus protocolos. Todas las funciones funcionan sin iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre Apple ID pour sauvegarder et synchroniser vos protocoles. Toutes les fonctionnalités fonctionnent sans connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID でサインインして、プロトコルをバックアップおよび同期します。すべての機能はサインインなしで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID로 로그인하여 프로토콜을 백업하고 동기화하세요. 모든 기능은 로그인 없이 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login com seu Apple ID para fazer backup e sincronizar seus protocolos. Todos os recursos funcionam sem fazer login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите с помощью Apple ID, чтобы создать резервную копию и синхронизировать протоколы. Все функции работают без входа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple ID 登录以备份和同步您的方案。所有功能无需登录即可工作。"
          }
        }
      }
    },
