    "The meal scanner hit a problem. Try again in a moment.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Måltidsskannern stötte på ett problem. Försök igen om en stund."
          }
        }
      }
    },
    "The new Today overview card pulls one number from each domain — compliance, calories, meal streak, daily check-in, water — into a single hero at the top of the scroll.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det nya översiktskortet i Idag hämtar ett tal från varje område – följsamhet, kalorier, måltidssvit, daglig incheckning, vatten – till ett och samma huvudkort högst upp."
          }
        }
      }
    },
    "The photo of the package you take or pick.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot av förpackningen som du tar eller väljer."
          }
