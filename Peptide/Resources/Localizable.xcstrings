    },
    "Cardio fitness, HRV and resting heart rate count most toward confidence, because they track aging most closely. Confidence also grows with each day of heart and sleep data, up to %lld days.": {
      "localizations": {
        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kondition, HRV och vilopuls väger tyngst för säkerheten, eftersom de följer åldrandet närmast. Säkerheten ökar också för varje dag med hjärt- och sömndata, upp till %lld dag."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kondition, HRV och vilopuls väger tyngst för säkerheten, eftersom de följer åldrandet närmast. Säkerheten ökar också för varje dag med hjärt- och sömndata, upp till %lld dagar."
                }
              }
            }
          }
        }
      }
    },
