    "Set up a peptide protocol to start tracking doses, streaks, and compliance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un protocolo de péptidos para comenzar a rastrear dosis, rachas y cumplimiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置肽方案以开始跟踪剂量、连胜和合规性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペプチドプロトコルをセットアップして、用量、連続日数、および準拠状況の追跡を開始します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie ein Peptidprotokoll ein, um Dosen, Serien und Einhaltung zu verfolgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez un protocole peptidique pour commencer à suivre les doses, les séries et la conformité."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure um protocolo de peptídeo para começar a rastrear doses, sequências e conformidade."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펩타이드 프로토콜을 설정하여 용량, 연속 기록 및 준수를 추적하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите протокол пептидов для отслеживания доз, серий и соответствия."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإعداد بروتوكول ببتيد لبدء تتبع الجرعات والسلاسل والامتثال."
