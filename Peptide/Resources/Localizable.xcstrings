    "Tap to remove. Use \"Add peptide\" to swap one in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para eliminar. Usa \"Agregar péptido\" para intercambiar uno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击以移除。使用添加肽来交换一个。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして削除します。ペプチドを追加を使用して交換します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie zum Entfernen. Verwenden Sie \"Peptid hinzufügen\", um es zu tauschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour supprimer. Utilisez « Ajouter peptide » pour en échanger un."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para remover. Use \"Adicionar peptídeo\" para trocar um."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 제거하세요. \"펩타이드 추가\"를 사용하여 교체하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы удалить. Используйте \"Добавить пептид\", чтобы его поменять."
          }
        },
        "ar": {
          "stringUnit": {
