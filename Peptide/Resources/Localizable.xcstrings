          }
        }
      }
    },
    "Atlas 2.1 reorganises the whole app around the question you actually open it to answer: \"What do I do today?\"": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlas 2.1 organiserar om hela appen kring frågan du faktiskt öppnar den för: ”Vad gör jag idag?”"
          }
        }
      }
