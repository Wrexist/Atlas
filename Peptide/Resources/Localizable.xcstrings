    "Tap a peptide to give it its own days and frequency.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على ببتيد لإعطائه أيامه وتكراره الخاص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf ein Peptid, um ihm eigene Tage und Häufigkeit zu geben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un péptido para darle sus propios días y frecuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un peptide pour lui donner ses propres jours et sa fréquence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペプチドをタップして、独自の日数と頻度を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
