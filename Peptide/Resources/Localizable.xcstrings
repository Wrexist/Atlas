      }
    },
    "That's not a food": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är inte mat"
          }
        }
      }
    },
    "That's not a product barcode": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är inte en produktstreckkod"
          }
        }
      }
    },
    "That's pet food — its nutrition is for an animal, not for your diary.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är djurmat – näringsvärdet gäller ett djur, inte din dagbok."
          }
        }
      }
    },
    "The account changed. Close this scan and reopen it.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontot har ändrats. Stäng skanningen och öppna den igen."
          }
