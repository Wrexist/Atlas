    "This offer is shown only once — it does not auto-renew.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta oferta se muestra solo una vez — no se renueva automáticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此优惠仅显示一次 — 不会自动续订。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオファーは1回だけ表示されます — 自動更新されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Angebot wird nur einmal angezeigt — es wird nicht automatisch erneuert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre s'affiche une seule fois — elle ne se renouvelle pas automatiquement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta oferta é exibida apenas uma vez — não se renova automaticamente."
          }
