    "PeptideX is a tracking and educational tool. It is not a medical device, and it does not provide medical advice, diagnosis, or treatment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX es una herramienta de seguimiento y educativa. No es un dispositivo médico y no proporciona asesoramiento, diagnóstico o tratamiento médico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX是一个跟踪和教育工具。它不是医疗设备，也不提供医疗建议、诊断或治疗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideXはトラッキングおよび教育ツールです。医療機器ではなく、医学的なアドバイス、診断、または治療を提供しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX ist ein Tracking- und Bildungstool. Es ist kein medizinisches Gerät und bietet keine medizinische Beratung, Diagnose oder Behandlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX est un outil de suivi et d'éducation. Ce n'est pas un dispositif médical et il ne fournit pas de conseil, diagnostic ou traitement médical."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX é uma ferramenta de rastreamento e educacional. Não é um dispositivo médico e não fornece aconselhamento, diagnóstico ou tratamento médico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX는 추적 및 교육 도구입니다. 의료 기기가 아니며 의료 조언, 진단 또는 치료를 제공하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX — это инструмент отслеживания и образования. Это не медицинское устройство и не предоставляет медицинские советы, диагнозы или лечение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PeptideX هي أداة تتبع وتعليمية. إنها ليست جهازاً طبياً ولا توفر نصائح أو تشخيص أو علاج طبي."
          }
        }
      }
    },
