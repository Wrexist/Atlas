        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Receptet finns inte längre i ditt bibliotek."
          }
        }
      }
    },
    "That's %lld weeks to commit.": {
      "localizations": {
        "sv": {
          "variations": {
