default_platform(:ios)

platform :ios do
  desc "Build and upload a TestFlight build (CI-safe, deterministic signing via match)"
  lane :beta do
    api_key_path = ENV.fetch("ASC_API_KEY_PATH")

    setup_ci

    match(
      type: "appstore",
      readonly: true,
      api_key_path: api_key_path
    )

    build_app(
      project: ENV.fetch("PROJECT"),
      scheme: ENV.fetch("SCHEME"),
      configuration: ENV.fetch("CONFIGURATION", "Release"),
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "#{ENV.fetch("SCHEME")}.ipa",
      include_bitcode: false
    )

    pilot(
      api_key_path: api_key_path,
      ipa: "build/#{ENV.fetch("SCHEME")}.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end

