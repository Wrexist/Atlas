default_platform(:ios)

platform :ios do
  desc "Fetch certs via match, build the iOS app, upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      duration:              1200,
      in_house:              false
    )

    target_to_bundle = {
      "Peptide"             => "com.peptidesai.app",
      "PeptideWidgets"      => "com.peptidesai.app.widgets",
      "PeptideWatch"        => "com.peptidesai.app.watchkitapp",
      "PeptideWatchWidgets" => "com.peptidesai.app.watchkitapp.widgets"
    }

    match(
      type:           "appstore",
      app_identifier: target_to_bundle.values,
      git_url:        ENV["MATCH_GIT_URL"],
      readonly:       false,
      api_key:        api_key
    )

    target_to_bundle.each do |target_name, bundle_id|
      update_code_signing_settings(
        path:                  "Peptide.xcodeproj",
        use_automatic_signing: false,
        targets:               [target_name],
        bundle_identifier:     bundle_id,
        team_id:               ENV["sigh_#{bundle_id}_appstore_team-id"],
        profile_name:          ENV["sigh_#{bundle_id}_appstore_profile-name"],
        code_sign_identity:    "Apple Distribution"
      )
    end

    build_app(
      project:       "Peptide.xcodeproj",
      scheme:        "Peptide",
      configuration: "Release",
      export_method: "app-store",
      clean:         true
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
